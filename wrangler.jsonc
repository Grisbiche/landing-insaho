// Configuration Cloudflare Workers (site statique, sans code serveur).
// Le champ "name" doit être identique au nom du Worker dans le tableau de bord Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing-insaho",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
